{
  "name": "amusement-park",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-version": "node scripts/generate-version.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "release:version:print": "node scripts/read-release-version.mjs",
    "security:patch-geolocation-policy": "node tools/patch-geolocation-permissions-policy.mjs",
    "prestart": "npm run generate-version && npm run i18n:build",
    "start": "ng serve",
    "prebuild": "npm run generate-version && npm run i18n:build && npm run security:patch-geolocation-policy",
    "build": "ng build",
    "prewatch": "npm run generate-version && npm run i18n:build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate-version && npm run i18n:build",
    "test": "ng test",
    "serve:ssr:AmusementPark": "node dist/amusement-park/server/server.mjs",
    "pretest:ci": "npm run generate-version && npm run i18n:build && npm run test:responsive:trips",
    "test:ci": "ng test --watch=false --coverage",
    "test:responsive:trips": "node tools/responsive/trip-pages-browser-check.mjs",
    "prebuild:ssr:local": "npm run generate-version && npm run i18n:build && npm run security:patch-geolocation-policy",
    "build:ssr:local": "ng build --configuration local-production",
    "seo:ssr-smoke": "node tools/seo-ssr-smoke.mjs",
    "architecture:facade-ports": "node tools/architecture/check-facade-data-ports.mjs",
    "architecture:one-class-per-file": "node tools/architecture/check-one-class-per-file.mjs",
    "architecture:one-class-per-file:test": "node --test tools/architecture/one-class-per-file.test.mjs",
    "architecture:product-analytics": "node tools/architecture/check-product-analytics.mjs",
    "quality:accessibility-i18n": "npm run i18n:check && node tools/quality/i18n-source-collision-check.mjs && node tools/quality/accessibility-check.mjs && node --test tools/quality/initial-theme.test.mjs",
    "quality:accessibility-i18n:test": "node --test tools/quality/i18n-source-collision-check.test.mjs tools/quality/accessibility-check.test.mjs",
    "privacy:catalog": "node tools/privacy/check-personal-data-catalog.mjs",
    "privacy:catalog:test": "node --test tools/privacy/personal-data-catalog.test.mjs",
    "test:performance-tools": "node --test tools/performance/performance-baseline.test.mjs tools/performance/bundle-budget.test.mjs",
    "performance:baseline": "node tools/performance/performance-baseline.mjs",
    "performance:bundle": "node tools/performance/bundle-budget.mjs",
    "operations:readiness": "node tools/operations/check-incident-readiness.mjs",
    "operations:readiness:test": "node --test tools/operations/incident-readiness.test.mjs tools/operations/production-alert-monitor.test.mjs",
    "operations:production-monitor": "node tools/operations/production-alert-monitor.mjs",
    "research:readiness": "node tools/research/check-research-readiness.mjs",
    "research:readiness:test": "node --test tools/research/research-readiness.test.mjs",
    "i18n:build": "node tools/i18n-build.mjs",
    "i18n:check": "node tools/i18n-build.mjs --check && node tools/i18n-check.mjs"
  },
  "private": true,
  "overrides": {
    "@hono/node-server": "2.0.11",
    "nanoid": "3.3.18",
    "@angular/build": {
      "undici": "7.29.1",
      "piscina": "5.3.2"
    },
    "node-gyp": {
      "undici": "6.28.1"
    }
  },
  "dependencies": {
    "@angular/animations": "21.2.24",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/platform-browser-dynamic": "21.2.24",
    "@angular/platform-server": "21.2.24",
    "@angular/router": "21.2.24",
    "@angular/ssr": "21.2.24",
    "@lucide/angular": "^1.23.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "express": "^4.18.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "ngx-matomo-client": "^9.1.0",
    "qrcode": "^1.5.4",
    "quill": "2.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@types/express": "^4.17.17",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.20.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "27.4.0",
    "sass": "1.97.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
