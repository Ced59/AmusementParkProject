{
  "name": "Niagara SkyWheel",
  "standaloneAttractionId": "a9836bee-4a11-4a31-870f-8b833efc3f46",
  "qualification": "Roue fixe à billet propre sur la rue de loisirs ouverte Clifton Hill. Le Fun Pass regroupe plusieurs billets mais Clifton Hill n’est pas un parc fermé avec zones et parkItems. Recherches officielles Standalone Niagara SkyWheel/SkyWheel et Park Niagara SkyWheel/Clifton Hill : aucun doublon.",
  "decision": "PublishedWithDocumentedGaps",
  "score": 98,
  "publicationBlockers": [],
