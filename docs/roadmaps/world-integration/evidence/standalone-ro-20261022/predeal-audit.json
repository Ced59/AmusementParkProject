{
  "name": "Predeal Mountain Coaster",
  "standaloneAttractionId": "d1b09350-8591-437e-82d7-2957573535b3",
  "qualification": "Mountain coaster fixe avec un tarif propre par descente au pied de Clăbucet ; indépendant comme fiche d’attraction, sans parc parent artificiel. Recherches Park et Standalone sur trois variantes sans résultat.",
  "decision": "PublishedWithDocumentedGaps",
  "score": 100,
  "publicationBlockers": [],
